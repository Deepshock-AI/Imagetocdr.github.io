            opacity: 0.9;
        }
        
        /* Converter Section */
        .converter-section {
            padding: 4rem 0;
            background-color: white;
        }
        
        .section-title {
            text-align: center;
            margin-bottom: 3rem;
        }
        
        .section-title h2 {
            font-size: 2.2rem;
            color: var(--primary-color);
            margin-bottom: 1rem;
        }
        
        .section-title p {
